<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_left_theme"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/screen_margin">

        <TextView
            android:id="@+id/contact_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contact_eyebrow"
            android:textAppearance="@style/TextAppearance.TravelPlanner.Eyebrow" />

        <TextView
            android:id="@+id/contact_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:maxWidth="@dimen/content_max_width"
            android:text="@string/contact_us_title"
            android:textAppearance="@style/TextAppearance.TravelPlanner.Headline" />

        <TextView
            android:id="@+id/contact_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:maxWidth="@dimen/content_max_width"
            android:text="@string/contact_description"
            android:textAppearance="@style/TextAppearance.TravelPlanner.Body" />

        <LinearLayout
            android:id="@+id/contact_action_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:background="@drawable/bg_surface_card"
            android:orientation="vertical">

            <TextView
                android:id="@+id/contact_action_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contact_action_label"
                android:textAppearance="@style/TextAppearance.TravelPlanner.Eyebrow" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/call_us_button"
                style="@style/Widget.TravelPlanner.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:text="@string/action_call_us"
                app:icon="@drawable/ic_contact_phone"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/space_small" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/locate_us_button"
                style="@style/Widget.TravelPlanner.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:text="@string/action_locate_us"
                app:icon="@drawable/ic_contact_location"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/space_small" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/email_us_button"
                style="@style/Widget.TravelPlanner.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:text="@string/action_email_us"
                app:icon="@drawable/ic_contact_email"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/space_small" />

        </LinearLayout>

        <TextView
            android:id="@+id/contact_privacy_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:maxWidth="@dimen/content_max_width"
            android:text="@string/contact_external_app_note"
            android:textAppearance="@style/TextAppearance.TravelPlanner.Body" />

    </LinearLayout>
</ScrollView>
