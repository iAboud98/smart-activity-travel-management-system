<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_left_theme"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/screen_margin">

        <TextView
            android:id="@+id/profile_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_eyebrow"
            android:textAppearance="@style/TextAppearance.TravelPlanner.Eyebrow" />

        <TextView
            android:id="@+id/profile_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:maxWidth="@dimen/content_max_width"
            android:text="@string/profile_management_title"
            android:textAppearance="@style/TextAppearance.TravelPlanner.Headline" />

        <TextView
            android:id="@+id/profile_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:background="@drawable/bg_surface_card"
            android:maxWidth="@dimen/content_max_width"
            android:text="@string/profile_load_error"
            android:textAppearance="@style/TextAppearance.TravelPlanner.Body"
            android:textColor="@color/color_error"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/profile_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/profile_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface_card"
                android:gravity="center_vertical"
                android:minHeight="@dimen/profile_summary_min_height"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/profile_image"
                    android:layout_width="@dimen/profile_avatar_size"
                    android:layout_height="@dimen/profile_avatar_size"
                    android:background="@drawable/bg_profile_avatar"
                    android:contentDescription="@string/profile_default_image_content_description"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_nav_profile" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_medium"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profile_full_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.TravelPlanner.SectionTitle" />

                    <TextView
                        android:id="@+id/profile_summary_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xsmall"
                        android:textAppearance="@style/TextAppearance.TravelPlanner.Body" />

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/select_profile_picture_button"
                style="@style/Widget.TravelPlanner.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:text="@string/action_select_profile_picture" />

            <TextView
                android:id="@+id/profile_details_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_large"
                android:text="@string/profile_details_label"
                android:textAppearance="@style/TextAppearance.TravelPlanner.Eyebrow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:background="@drawable/bg_surface_card"
                android:minHeight="@dimen/list_item_min_height"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_email_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_email_label"
                    android:textAppearance="@style/TextAppearance.TravelPlanner.Eyebrow" />

                <TextView
                    android:id="@+id/profile_email_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xsmall"
                    android:textAppearance="@style/TextAppearance.TravelPlanner.Body" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:background="@drawable/bg_surface_card"
                android:minHeight="@dimen/list_item_min_height"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_gender_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_gender_label"
                    android:textAppearance="@style/TextAppearance.TravelPlanner.Eyebrow" />

                <TextView
                    android:id="@+id/profile_gender_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xsmall"
                    android:textAppearance="@style/TextAppearance.TravelPlanner.Body" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:background="@drawable/bg_surface_card"
                android:minHeight="@dimen/list_item_min_height"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_preference_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_preference_label"
                    android:textAppearance="@style/TextAppearance.TravelPlanner.Eyebrow" />

                <TextView
                    android:id="@+id/profile_preference_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xsmall"
                    android:textAppearance="@style/TextAppearance.TravelPlanner.Body" />

            </LinearLayout>

            <TextView
                android:id="@+id/profile_edit_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_large"
                android:text="@string/profile_edit_label"
                android:textAppearance="@style/TextAppearance.TravelPlanner.Eyebrow" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/profile_first_name_input_layout"
                style="@style/Widget.TravelPlanner.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:hint="@string/profile_first_name_label"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/profile_first_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/profile_last_name_input_layout"
                style="@style/Widget.TravelPlanner.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:hint="@string/profile_last_name_label"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/profile_last_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/profile_phone_input_layout"
                style="@style/Widget.TravelPlanner.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:hint="@string/profile_phone_label"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/profile_phone_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="phone"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/profile_password_input_layout"
                style="@style/Widget.TravelPlanner.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:hint="@string/profile_new_password_label"
                app:endIconMode="password_toggle"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/profile_password_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/profile_confirm_password_input_layout"
                style="@style/Widget.TravelPlanner.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:hint="@string/profile_confirm_password_label"
                app:endIconMode="password_toggle"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/profile_confirm_password_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_profile_button"
                style="@style/Widget.TravelPlanner.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_large"
                android:text="@string/action_save" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
