<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <!-- recommended trips section - trips with rating >= 4.5 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_recommended_trips"
            android:textAppearance="@style/TextAppearance.TravelPlanner.SectionTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trips with a rating of 4.5 and above."
            android:textAppearance="@style/TextAppearance.TravelPlanner.Body" />

        <TextView
            android:id="@+id/top_rated_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:text="No recommended trips available."
            android:textAppearance="@style/TextAppearance.TravelPlanner.Body"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/top_rated_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:nestedScrollingEnabled="false" />

        <!-- popular destinations section - trips with most reservations -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:text="@string/label_popular_destinations"
            android:textAppearance="@style/TextAppearance.TravelPlanner.SectionTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/popular_destinations_description"
            android:textAppearance="@style/TextAppearance.TravelPlanner.Body" />

        <TextView
            android:id="@+id/popular_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:text="@string/popular_destinations_empty_state"
            android:textAppearance="@style/TextAppearance.TravelPlanner.Body"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/popular_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:nestedScrollingEnabled="false" />

        <!-- trending this week section - trips with 3+ reservations in last 7 days -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:text="Trending This Week"
            android:textAppearance="@style/TextAppearance.TravelPlanner.SectionTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trips that received 3 or more reservations in the last 7 days."
            android:textAppearance="@style/TextAppearance.TravelPlanner.Body" />

        <TextView
            android:id="@+id/trending_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:text="No trending trips this week."
            android:textAppearance="@style/TextAppearance.TravelPlanner.Body"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/trending_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>