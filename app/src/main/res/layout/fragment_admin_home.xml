<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Admin Panel"
            android:textAppearance="@style/TextAppearance.TravelPlanner.Headline" />

        <TextView
            android:id="@+id/admin_home_signed_in"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:textAppearance="@style/TextAppearance.TravelPlanner.Eyebrow" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:text="@string/admin_home_description"
            android:textAppearance="@style/TextAppearance.TravelPlanner.Body" />

        <!-- users section -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TravelPlanner.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="User Management"
                    android:textAppearance="@style/TextAppearance.TravelPlanner.SectionTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xsmall"
                    android:text="Add admins, view registered users, and manage accounts."
                    android:textAppearance="@style/TextAppearance.TravelPlanner.Body" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- trips section -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TravelPlanner.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Trip Management"
                    android:textAppearance="@style/TextAppearance.TravelPlanner.SectionTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xsmall"
                    android:text="Add, edit, and delete trips available to travelers."
                    android:textAppearance="@style/TextAppearance.TravelPlanner.Body" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- reservations section -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TravelPlanner.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reservations"
                    android:textAppearance="@style/TextAppearance.TravelPlanner.SectionTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xsmall"
                    android:text="View all reservations made by travelers across all trips."
                    android:textAppearance="@style/TextAppearance.TravelPlanner.Body" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>