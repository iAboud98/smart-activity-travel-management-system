<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <!-- title changes between Add Trip and Edit Trip -->
        <TextView
            android:id="@+id/trip_form_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TravelPlanner.Headline" />

        <EditText
            android:id="@+id/trip_form_destination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:hint="Destination"
            android:inputType="text"
            android:padding="8dp"
            android:background="@color/color_surface" />

        <EditText
            android:id="@+id/trip_form_country"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:hint="Country"
            android:inputType="text"
            android:padding="8dp"
            android:background="@color/color_surface" />

        <EditText
            android:id="@+id/trip_form_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:hint="Duration (days)"
            android:inputType="number"
            android:padding="8dp"
            android:background="@color/color_surface" />

        <EditText
            android:id="@+id/trip_form_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:hint="Price ($)"
            android:inputType="numberDecimal"
            android:padding="8dp"
            android:background="@color/color_surface" />

        <EditText
            android:id="@+id/trip_form_rating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:hint="Rating (0.0 - 5.0)"
            android:inputType="numberDecimal"
            android:padding="8dp"
            android:background="@color/color_surface" />

        <EditText
            android:id="@+id/trip_form_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:hint="Description"
            android:inputType="textMultiLine"
            android:lines="3"
            android:padding="8dp"
            android:background="@color/color_surface" />

        <EditText
            android:id="@+id/trip_form_image_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:hint="Image URL"
            android:inputType="textUri"
            android:padding="8dp"
            android:background="@color/color_surface" />

        <Button
            android:id="@+id/trip_form_save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:text="Save Trip" />

        <Button
            android:id="@+id/trip_form_cancel_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:text="Cancel" />

    </LinearLayout>
</ScrollView>